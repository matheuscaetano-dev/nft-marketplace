{
  "extends": "lighthouse:default",
  "settings": {
    "formFactor": "desktop",
    "screenEmulation": {
      "mobile": false,
      "width": 1440,
      "height": 900,
      "deviceScaleFactor": 1,
      "disabled": true
    },
    "throttlingMethod": "simulate",
    "throttling": {
      "rttMs": 40,
      "throughputKbps": 10240,
      "cpuSlowdownMultiplier": 1,
      "requestLatencyMs": 0,
      "downloadThroughputKbps": 0,
      "uploadThroughputKbps": 0
    },
    "onlyCategories": [
      "performance",
      "accessibility",
      "best-practices",
      "seo"
    ]
  }
}
